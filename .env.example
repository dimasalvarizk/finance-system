# ==========================================
# FINANCE SYSTEM ENVIRONMENT TEMPLATE
# ==========================================
# Salin file ini menjadi .env di server VPS atau
# masukkan variabel di bawah ini ke menu Environment Variables di Coolify / Docker.

# --- DATABASE CONFIGURATION ---
MYSQL_ROOT_PASSWORD=isikan_password_root_mysql
MYSQL_DATABASE=finance_db
MYSQL_USER=dst_user
MYSQL_PASSWORD=isikan_password_user_mysql
MYSQL_PORT=3307

DB_HOST=mysql-db
DB_PORT=3306
DB_USER=dst_user
DB_PASSWORD=isikan_password_user_mysql
DB_NAME=finance_db

# --- SECURITY / JWT ---
JWT_SECRET=isikan_jwt_secret_panjang_dan_acak

# --- FRONTEND & APIS ---
FRONTEND_URL=https://odstfin.io
VITE_AUTH_API_URL=https://api.odstfin.io
VITE_INVOICE_API_URL=https://api.odstfin.io
VITE_REQUEST_API_URL=https://api.odstfin.io
VITE_SETTING_API_URL=https://api.odstfin.io
VITE_HOTEL_RESERVATION_API_URL=https://api.odstfin.io

# --- SMTP EMAIL CONFIGURATION ---
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@odst.id
SMTP_PASS=isikan_password_smtp_anda
SMTP_FROM=info@odst.id
